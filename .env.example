# Public site URL — used to build sitemap.xml and canonical links (no trailing slash)
VITE_SITE_URL=https://www.your-domain.pk

# Where inquiry forms are delivered. Any endpoint that accepts a JSON POST works,
# e.g. Formspree (https://formspree.io/f/xxxx), Web3Forms, Getform, or your own API.
# Leave empty and visitors are offered one-tap WhatsApp / email delivery instead.
VITE_INQUIRY_ENDPOINT=
